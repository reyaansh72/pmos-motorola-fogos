6ada2c331e57aec3e25907256f9e73c0f2d9d3d5e3a1cfc846b0ad62327edf2c6b7dc017dc36a8a64de3e2da5b84b654aea45d267042fed783beb99c0efc98c3  config-motorola-fogos.aarch64
"
