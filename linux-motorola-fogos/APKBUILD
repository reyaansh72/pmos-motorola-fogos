553fc22505e39d8a2264e0827c2ea64425a39f06e80f0a9c7cb3786918a202dc88bc284992139d6b48161b280d04804a11c33e8d21aa4a5ecc5aabc1822b97f9  config-motorola-fogos.aarch64
"
