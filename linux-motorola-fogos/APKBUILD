# Kernel config based on: arch/arm64/configs/vendor/holi-qgki_defconfig

maintainer="reyaansh72 <bhavya150520@gmail.com>"
pkgname=linux-motorola-fogos
pkgver=5.4.302
pkgrel=0
_branch="postmarketos-motorola-fogos"
_commit=6ad40bbece9c25275752c07e1fb9320c37425fe5
pkgdesc="Motorola Moto G45 5G kernel fork"
arch="aarch64"
url="https://github.com/reyaansh72/android_kernel_motorola_sm6375"
license="GPL-2.0-only"

makedepends="
        bash
        bc
        bison
        devicepkg-dev
        elfutils-dev
        findutils
        flex
        linux-headers
        openssl-dev
        pahole
        perl
        python3
        "

source="
        $pkgname-$_branch.tar.gz::https://github.com/reyaansh72/android_kernel_motorola_sm6375/archive/refs/heads/$_branch.tar.gz
        config-${pkgname#linux-}.$arch
"

builddir="$srcdir/android_kernel_motorola_sm6375-$_branch"

options="
        !check
        !strip
        !tracedeps
        pmb:cross-native
        "

_outdir="out"
_carch="arm64"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor' and '_config'.
_config="config-${pkgname#linux-}.$arch"
_flavor="${pkgname#linux-}"


prepare() {
        default_prepare
        REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
        REPLACE_GCCH=0
        unset LDFLAGS
        make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
                KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"-postmarketOS
}


package() {
        downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
                "${pkgname#linux-}" "$_outdir"
        make dtbs_install O="$_outdir" ARCH="$_carch" \
                INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
}

sha512sums="
